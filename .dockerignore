# Secrets / OAuth token caches — must never be baked into an image
.cache
src/etl/.cache
.env
.env.*

# Python bytecode / caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Local virtualenv (image builds its own)
.venv/

# ETL intermediate data
src/etl/data/

# VCS / editor / project scratch
.git/
.gitignore
.streamlit/
*.png
debug.py
